# Personal Career Platform — variables d'environnement
# Copier vers .env puis remplir. Ne JAMAIS versionner .env.

# PostgreSQL hébergé — Neon
# Format : postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:pass@ep-XXXX.eu-central-1.aws.neon.tech/personal-career-platform?sslmode=require"

# Redis — Upstash (REST) : sessions + rate limiting du login
REDIS_URL="https://dear-xxxx.upstash.io"
REDIS_TOKEN="change-me"

# Signature des JWT de session (HS256) — 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-at-least-32-characters-long"

# Chatbot RAG — Google Gemini (serveur uniquement, jamais NEXT_PUBLIC_)
# Clé : https://aistudio.google.com/apikey
GEMINI_API_KEY="change-me"
# Optionnels :
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# RAG_MIN_SCORE="0.45"   # similarité minimale pour qu'un extrait soit utilisé

# Stockage des médias : "local" (dev, défaut) ou "vercel-blob" (production)
STORAGE_DRIVER="local"
# Driver local : dossier de stockage (défaut : ./uploads, hors public/)
# UPLOAD_DIR="/var/data/uploads"
# Driver vercel-blob : jeton du Blob store (injecté par Vercel quand le store
# est connecté au projet ; à copier ici seulement pour tester en local)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXX_YYYY"
# Optionnel : forcer la base des URL publiques du store
# BLOB_PUBLIC_BASE_URL="https://xxxx.public.blob.vercel-storage.com"

# IP client derrière un proxy (voir README « IP client, proxy et rate limiting »)
# Lire x-real-ip / x-forwarded-for : true derrière un proxy de confiance.
# Automatique sur Vercel (VERCEL=1) ; false pour désactiver partout.
# TRUST_PROXY="true"
# Nombre de proxys de confiance devant l'app (x-forwarded-for lu depuis la droite)
# TRUST_PROXY_HOPS="1"
# Questions/minute au chatbot, toutes IP confondues (sous le quota Gemini)
# CHAT_GLOBAL_PER_MINUTE="8"

# Graine admin (utilisé seulement par `prisma db seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong"
